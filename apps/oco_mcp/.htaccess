# Die composer-Dateien der App gehoeren nicht ins Web.
#
# Bewusst OHNE "RewriteEngine on": Apache vererbt die Rewrite-Regeln eines
# uebergeordneten Verzeichnisses nicht, sobald ein Unterverzeichnis die Engine
# selbst einschaltet. Eine Regel hier haette also die Front-Controller-Regel
# der Wurzel-.htaccess ausser Kraft gesetzt und die Route
# /apps/oco_mcp/mcp auf Installationen mit huebschen Adressen ins Leere
# laufen lassen.
#
# Fuer vendor/ und tests/ steht je eine eigene .htaccess im Verzeichnis selbst.
<FilesMatch "\.(json|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
