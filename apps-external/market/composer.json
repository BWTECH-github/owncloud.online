{
  "name": "bwtech/market",
  "description": "ownCloud Market plugin (PHP 8.4 fork of owncloud/market for owncloud.online).",
  "license": "AGPL-3.0",
  "type": "owncloud-app",
  "config": {
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false
    }
  }
}
